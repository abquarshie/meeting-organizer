# Copy this file to .env for running the app on your own computer. On Vercel, put the same names under
# Settings -> Environment Variables instead (the Neon integration adds DATABASE_URL for you).

# Your own new Neon database: Neon -> your project -> Connect -> the pooled connection string.
# The tables are created from api/db/schema.sql by `npm run db:setup` and by every Vercel build.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Optional: Neon's direct (unpooled) connection string, used only to create the tables.
# DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Any long random string (at least 32 characters). Signs the sign-in cookie; the Python function checks it too.
SESSION_SECRET="change-me-to-a-long-random-string-of-32-or-more"

# The one password that opens the app. There is only one user, so there are no user names.
APP_PASSWORD="choose-a-password"
